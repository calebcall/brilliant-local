[Unit]
Description=Brilliantly Local agent (message bus -> JSON/TCP for Home Assistant)
After=message_bus.service network-online.target
Wants=message_bus.service

[Service]
Type=simple
ExecStart=/data/switch-embedded/env/bin/python3 /var/brilliant-local/app/brilliant_local_agent.py
Restart=always
RestartSec=5
# Keep the agent from ever degrading the panel UI.
Nice=10
MemoryMax=64M
CPUQuota=15%
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
